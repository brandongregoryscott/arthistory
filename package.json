{
    "description": "Art history data aggregation and visualization",
    "type": "module",
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "26.6.5",
        "@vitest/eslint-plugin": "1.6.28",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "eslint-plugin-collation": "1.9.2",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-package-json": "1.4.0",
        "eslint-plugin-perfectionist": "5.13.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "gagen": "0.8.0",
        "husky": "9.1.4",
        "jsonc-eslint-parser": "3.3.0",
        "lint-staged": "15.2.8",
        "prettier": "3.9.10",
        "tsx": "4.20.5",
        "turbo": "2.11.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vitest": "5.1.1"
    },
    "engines": {
        "node": ">=26.12.1 <27"
    },
    "lint-staged": {
        "*.{ts,tsx,json,md}": "prettier --ignore-unknown --write",
        "*.{ts,tsx}": "eslint --cache --fix"
    },
    "name": "arthistory",
    "packageManager": "npm@11.20.0",
    "private": true,
    "scripts": {
        "add-artist": "tsx apps/api/src/scripts/add-artist.ts",
        "build": "turbo build && npm run build:pocketbase",
        "build:force": "turbo build --force && npm run build:pocketbase",
        "build:pocketbase": "tsx pocketbase/build.ts",
        "ci:check": "gagen --lint",
        "ci:generate": "gagen",
        "ci:lint": "eslint --config .github/eslint.config.mjs .github/workflows/*.mts",
        "ci:typecheck": "tsc -p .github/tsconfig.json",
        "ci:update-pins": "gagen --update-pins",
        "clean": "rm -rf node_modules build apps/**/node_modules packages/**/node_modules apps/**/dist apps/**/build packages/**/dist packages/**/build pocketbase/dist",
        "dev": "turbo dev",
        "format": "prettier --check \"**/*.{json,js,ts,tsx,md}\"",
        "format:fix": "prettier --write \"**/*.{json,js,ts,tsx,md}\"",
        "inspect-artist": "tsx apps/api/src/scripts/inspect-artist.ts",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --max-warnings 0 --fix",
        "prepare": "husky || exit 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "npm run typecheck --workspaces --if-present && tsc -p pocketbase && tsc -p scripts"
    },
    "version": "0.0.0-development",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    }
}
