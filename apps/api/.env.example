PORT=3001
CLIENT_ID=abc
CLIENT_SECRET=xyz
DATABASE_PATH=~/spotify-data/output/_spotify-data.db

# Native metrics listener; Compose binds internally without publishing a port.
# Choose another port when running multiple APIs natively on the same machine.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464

LOG_LEVEL=info

# Native development connects directly. Compose sets one HTTP tunnel hop and
# publishes the API on loopback only; keep public access behind that tunnel.
TRUST_PROXY_HOPS=0
