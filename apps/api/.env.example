PORT=6768

# Native metrics listener; Compose binds internally without publishing a port.
# Choose another port when running multiple APIs natively on the same machine.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464

LOG_LEVEL=info

# Native development connects directly. Compose sets one HTTP tunnel hop and
# publishes the API on loopback only; keep public access behind that tunnel.
TRUST_PROXY_HOPS=0

# Host-side PocketBase access. Containers use http://pocketbase:8090 instead.
# If you change the published port, update POCKETBASE_URL to match.
DB_PORT=6769
POCKETBASE_URL=http://127.0.0.1:6769
POCKETBASE_SUPERUSER_EMAIL=owner@example.com
POCKETBASE_SUPERUSER_PASSWORD=

# Production dashboard tunnel name; the SSH key must be registered with tuns.sh.
POCKETBASE_TUNNEL_NAME=arthistory-pocketbase
TUNS_SSH_KEY_PATH=/root/.ssh/tuns_ed25519
