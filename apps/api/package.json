{
    "description": "API for the arthistory application",
    "type": "commonjs",
    "dependencies": {
        "@prometheus-io/client": "0.16.1",
        "@repo/common": "*",
        "@spotify/web-api-ts-sdk": "1.2.0",
        "cors": "2.8.5",
        "date-fns": "3.6.0",
        "dotenv": "16.3.1",
        "esbuild": "0.18.18",
        "express": "5.3.0",
        "express-rate-limit": "6.8.1",
        "lodash": "4.17.21",
        "pino": "10.3.1",
        "posthog-js": "1.144.2",
        "serialize-error": "8.1.0",
        "sqlite": "5.1.1",
        "sqlite3": "6.0.1"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/cors": "2.8.13",
        "@types/express": "5.0.6",
        "@types/lodash": "4.14.195",
        "@types/node": "26.6.5",
        "concurrently": "8.2.0",
        "eslint": "9.39.3",
        "nodemon": "3.0.1",
        "typescript": "5.9.3",
        "vitest": "4.1.12"
    },
    "name": "api",
    "private": true,
    "scripts": {
        "build": "esbuild src/server.ts --bundle --platform=node --target=node26 --outfile=dist/server.js",
        "postbuild": "rm -rf ../../build build && cp -r ../../node_modules/sqlite3/build ../.. && cp -r ../../node_modules/sqlite3/build .",
        "clean": "rm -rf dist",
        "dev": "concurrently --names esbuild,nodemon \"npm run build -- --watch\" \"nodemon -q dist/server.js\"",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "version": "1.0.0"
}
