{
    "description": "API for the arthistory application",
    "type": "commonjs",
    "dependencies": {
        "@prometheus-io/client": "0.16.1",
        "@repo/common": "*",
        "cors": "2.8.5",
        "dotenv": "16.3.1",
        "esbuild": "0.28.2",
        "express": "5.3.0",
        "express-rate-limit": "6.8.1",
        "fuse.js": "7.5.0",
        "lodash": "4.17.21",
        "pino": "10.4.0",
        "pocketbase": "0.28.1",
        "posthog-js": "1.144.2"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/cors": "2.8.13",
        "@types/express": "5.0.6",
        "@types/lodash": "4.14.195",
        "@types/node": "26.6.5",
        "concurrently": "8.2.0",
        "eslint": "9.39.5",
        "nodemon": "3.0.1",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    },
    "name": "api",
    "private": true,
    "scripts": {
        "build": "esbuild src/server.ts --bundle --platform=node --target=node26 --outfile=dist/server.js && npm run build:cli",
        "build:cli": "esbuild src/scripts/index.ts --bundle --platform=node --target=node26 --outbase=src --outdir=dist/cli",
        "clean": "rm -rf dist",
        "dev": "concurrently --names esbuild,nodemon \"npm run build -- --watch\" \"nodemon -q dist/server.js\"",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "version": "1.0.0"
}
