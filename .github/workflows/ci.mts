import { job, step, workflow } from "gagen";

const checkout = step({ uses: "actions/checkout@v7.0.1" });

const setupNode = step.dependsOn(checkout)({
    uses: "actions/setup-node@v7.1.0",
    with: { "node-version-file": ".nvmrc", cache: "npm" },
});

const install = step.dependsOn(setupNode)({
    name: "Install dependencies",
    run: "npm ci",
});

const workflowCheck = job("workflow", {
    name: "workflow",
    runsOn: "ubuntu-latest",
    timeoutMinutes: 15,
    steps: [
        step.dependsOn(install)({
            name: "Check workflow source and generation",
            run: `npm run ci:typecheck
npm run ci:lint
npm run ci:check
npm exec prettier -- --check .github/workflows/ci.mts .github/tsconfig.json .github/eslint.config.mjs`,
        }),
        step({
            uses: "docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667",
            with: { args: "-color .github/workflows/ci.generated.yml" },
        }),
    ],
});

const checks = job("checks", {
    name: "${{ matrix.script }}",
    runsOn: "ubuntu-latest",
    timeoutMinutes: 15,
    strategy: {
        failFast: false,
        matrix: { script: ["format", "lint", "typecheck", "test", "build"] },
    },
    steps: [
        step.dependsOn(install)({
            name: "Run check",
            run: "npm run ${{ matrix.script }}",
        }),
    ],
});

const containers = job("containers", {
    name: "container (${{ matrix.image }})",
    runsOn: "ubuntu-latest",
    timeoutMinutes: 30,
    strategy: { failFast: false, matrix: { image: ["api", "cron"] } },
    steps: [
        checkout,
        step({ uses: "docker/setup-buildx-action@v4.4.1" }),
        step({
            name: "Build image",
            uses: "docker/build-push-action@v7.4.0",
            with: {
                context: ".",
                file: "Dockerfile.${{ matrix.image }}",
                push: false,
                load: true,
                tags: "ci-${{ matrix.image }}:check",
                "build-args": "SOURCE_VERSION=${{ github.sha }}",
                "cache-from": "type=gha,scope=${{ matrix.image }}",
                "cache-to": "type=gha,mode=max,scope=${{ matrix.image }}",
            },
        }),
        step({
            name: "Load API SQLite binding",
            if: "matrix.image == 'api'",
            run: "docker run --rm --entrypoint node ci-api:check -e \"require('./build/Release/node_sqlite3.node')\"",
        }),
        step({
            name: "Query cron SQLite database",
            if: "matrix.image == 'cron'",
            run: "docker run --rm --entrypoint node ci-cron:check -e \"const sqlite = require('/app/node_modules/sqlite3'); const db = new sqlite.Database(':memory:'); db.exec('CREATE TABLE smoke (id INTEGER)', error => { if (error) throw error; db.close(); });\"",
        }),
    ],
});

const ci = job("ci", {
    name: "ci",
    runsOn: "ubuntu-latest",
    timeoutMinutes: 5,
    needs: [workflowCheck, checks, containers],
    if: "always()",
    steps: [
        step({
            name: "Require every validation to succeed",
            env: { RESULTS: "${{ join(needs.*.result, ' ') }}" },
            run: `if [[ -z "$RESULTS" ]]; then
    echo "No validation results were provided"
    exit 1
fi
read -r -a results <<< "$RESULTS"
for result in "\${results[@]}"; do
    if [[ "$result" != "success" ]]; then
        echo "Validation result: $result"
        exit 1
    fi
done`,
        }),
    ],
});

workflow({
    name: "CI",
    on: {
        push: { branches: ["main"] },
        pull_request: { branches: ["main"] },
        workflow_dispatch: {},
    },
    permissions: { contents: "read" },
    concurrency: {
        group: "${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}",
        cancelInProgress: "${{ github.event_name != 'push' }}",
    },
    defaults: { run: { shell: "bash" } },
    jobs: [workflowCheck, checks, containers, ci],
}).writeOrLint({
    filePath: new URL("./ci.generated.yml", import.meta.url),
    header: "# Generated by ci.mts. Run npm run ci:generate; do not edit directly.",
});
