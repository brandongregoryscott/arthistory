{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env*"],
    "globalEnv": ["DEBUG"],
    "tasks": {
        "build": {
            "env": ["VITE_API_URL"],
            "inputs": ["$TURBO_DEFAULT$", ".env"],
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "dev": {
            "env": ["VITE_API_URL"],
            "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
            "cache": false,
            "persistent": true
        }
    }
}
