{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env*"],
    "globalEnv": ["DEBUG"],
    "tasks": {
        "build": {
            "env": [
                "VITE_API_URL",
                "AWS_S3_ENDPOINT",
                "AWS_ACCESS_KEY_ID",
                "AWS_SECRET_ACCESS_KEY",
                "CLIENT_IDS",
                "CLIENT_SECRETS"
            ],
            "inputs": ["$TURBO_DEFAULT$", ".env"],
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "dev": {
            "env": ["VITE_API_URL"],
            "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
            "cache": false,
            "persistent": true
        }
    }
}
